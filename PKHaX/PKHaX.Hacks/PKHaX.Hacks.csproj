<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PKHaX.Hacks</AssemblyName>
    <RootNamespace>PKHaX.Hacks</RootNamespace>
    <Description>ROM hack support for PKHaX</Description>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PKHeX.Core\PKHeX.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\**" />
    <EmbeddedResource Include="Resources\**" />
    <EmbeddedResource Include="Profiles\BuiltIn\*.pkhaxprofile.json" LogicalName="PKHaX.Hacks.Profiles.BuiltIn.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
