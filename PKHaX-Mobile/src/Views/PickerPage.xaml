<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:PKHaX.Mobile.Services"
             x:Class="PKHaX.Mobile.Views.PickerPage"
             Title="Select"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*" Padding="12" RowSpacing="8">
        <SearchBar Grid.Row="0" x:Name="Search" Placeholder="Type to filter…"
                   TextChanged="OnSearchChanged"
                   BackgroundColor="{StaticResource Surface}"
                   TextColor="{StaticResource Text}"
                   PlaceholderColor="{StaticResource Muted}" />

        <CollectionView Grid.Row="1" x:Name="List" SelectionMode="Single"
                        SelectionChanged="OnSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="svc:NamedValue">
                    <Grid Padding="14,12" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{Binding Name}" FontSize="16"
                               TextColor="{StaticResource Text}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Value}" FontSize="12"
                               TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
