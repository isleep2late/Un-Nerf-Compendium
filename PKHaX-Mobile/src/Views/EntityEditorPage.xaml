<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PKHaX.Mobile.Views.EntityEditorPage"
             Title="Edit"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="16">

            <HorizontalStackLayout Spacing="14">
                <Image x:Name="Sprite" HeightRequest="72" WidthRequest="72" Aspect="AspectFit" />
                <VerticalStackLayout VerticalOptions="Center">
                    <Label x:Name="HeaderName" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Text}" />
                    <Label x:Name="HeaderDetail" FontSize="13" TextColor="{StaticResource Muted}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!-- Species -->
            <Label Text="Species" Style="{StaticResource FieldLabel}" />
            <Picker x:Name="SpeciesPicker" SelectedIndexChanged="OnSpeciesChanged"
                    BackgroundColor="{StaticResource Surface}" TextColor="{StaticResource Text}" />

            <!-- Level -->
            <Label Text="Level" Style="{StaticResource FieldLabel}" />
            <HorizontalStackLayout Spacing="12">
                <Stepper x:Name="LevelStepper" Minimum="1" Maximum="100" Increment="1"
                         ValueChanged="OnLevelChanged" />
                <Label x:Name="LevelValue" FontSize="16" VerticalOptions="Center" TextColor="{StaticResource Text}" />
            </HorizontalStackLayout>

            <!-- Ability: full list, so Gen 3 any-ability works exactly like the desktop PKHaX -->
            <Label Text="Ability" Style="{StaticResource FieldLabel}" />
            <Picker x:Name="AbilityPicker" SelectedIndexChanged="OnAbilityChanged"
                    BackgroundColor="{StaticResource Surface}" TextColor="{StaticResource Text}" />
            <Label x:Name="AbilityHint" FontSize="11" TextColor="{StaticResource Muted}" />

            <!-- Shiny -->
            <HorizontalStackLayout Spacing="12">
                <Label Text="Shiny" FontSize="16" VerticalOptions="Center"
                       HorizontalOptions="StartAndExpand" TextColor="{StaticResource Text}" />
                <Switch x:Name="ShinySwitch" Toggled="OnShinyToggled" OnColor="{StaticResource Accent}" />
            </HorizontalStackLayout>

            <!-- Moves -->
            <Label Text="Moves" Style="{StaticResource FieldLabel}" />
            <Picker x:Name="Move1" Title="Move 1" SelectedIndexChanged="OnMoveChanged"
                    BackgroundColor="{StaticResource Surface}" TextColor="{StaticResource Text}" />
            <Picker x:Name="Move2" Title="Move 2" SelectedIndexChanged="OnMoveChanged"
                    BackgroundColor="{StaticResource Surface}" TextColor="{StaticResource Text}" />
            <Picker x:Name="Move3" Title="Move 3" SelectedIndexChanged="OnMoveChanged"
                    BackgroundColor="{StaticResource Surface}" TextColor="{StaticResource Text}" />
            <Picker x:Name="Move4" Title="Move 4" SelectedIndexChanged="OnMoveChanged"
                    BackgroundColor="{StaticResource Surface}" TextColor="{StaticResource Text}" />

            <Button Text="Apply to box slot" Clicked="OnApplyClicked" Margin="0,8,0,0"
                    HeightRequest="52" CornerRadius="12"
                    BackgroundColor="{StaticResource Positive}" TextColor="White" />
            <Label x:Name="LegalityLabel" FontSize="12" TextColor="{StaticResource Muted}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
